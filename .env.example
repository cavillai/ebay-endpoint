# If you'd like to configure a S3 cache, you can do so by providing AWS
# credentials that have access to S3
AWS_ACCESS_KEY_ID=<Enter AWS Access Key ID>
AWS_SECRET_ACCESS_KEY=<Enter secret Access Key>

# Anthropic Claude API (for AI script generation)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=<Enter Anthropic API Key>

# eBay Browse API Credentials
# Get Client Secret from: https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=WorkStre-ListingV-PRD-d40b96357-f8e0b451
EBAY_CLIENT_SECRET=<Enter eBay Client Secret>

# eBay Marketplace Account Deletion Notification Settings
# Verification token (32-80 alphanumeric characters, underscores, or hyphens)
# Used for validating challenge codes from eBay's account deletion notifications
# See: https://developer.ebay.com/develop/guides-v2/marketplace-user-account-deletion/marketplace-user-account-deletion
EBAY_VERIFICATION_TOKEN=<Enter your 32-80 character verification token>
